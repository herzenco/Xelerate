# App
NEXT_PUBLIC_SITE_URL=https://xelerate.me

# Supabase public client
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# Legacy anon keys still work, but Supabase recommends publishable keys for new setup.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-public-anon-key

# Admin auth hardening (reserved for rate limiting)
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# Database
# Use either a Neon URL or the Supabase Postgres connection string.
DATABASE_URL=postgres://user:password@host.neon.tech/db?sslmode=require

# AI content generation
ANTHROPIC_API_KEY=sk-ant-...
BLOG_MODEL=claude-sonnet-4-5-20250929
VOYAGE_API_KEY=pa-...

# Analytics
VERCEL_ANALYTICS_DASHBOARD_URL=https://vercel.com/your-team/your-project/analytics
PLAUSIBLE_API_KEY=...
PLAUSIBLE_SITE_ID=xelerate.me

# Cron
CRON_SECRET=replace-with-random-bearer-token
